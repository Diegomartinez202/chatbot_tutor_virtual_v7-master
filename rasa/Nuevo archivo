slots:

  historial_academico:
    type: text
    influence_conversation: false
    mappings:
      - type: from_text
        intent: informar_historial_academico
      - type: custom


  session_activa:
    type: bool
  influence_conversation: true
  mappings:
    - type: custom

  encuesta_incompleta:
    type: bool
    influence_conversation: true
    initial_value: false
    mappings:
      - type: custom

proceso_activo:
  type: text
  influence_conversation: true
  mappings:
    - type: custom



  turnos_conversacion:
    type: float
    influence_conversation: false
    mappings:
      - type: custom

  user_token:
    type: text


  slot_tipo_usuario:
    type: categorical
    values:
      - usuario
      - admin

auth_state:
  type: categorical
  values:
    - inactive
    - active
  influence_conversation: false
  initial_value: inactive
  mappings:
    - type: custom

is_authenticated:
  type: bool
  influence_conversation: true
  initial_value: false
  mappings:
    - type: custom

email:
  type: text
  influence_conversation: false
  mappings:
    - type: from_entity
      entity: email
    - type: custom

    - type: from_text
      conditions:
        - active_loop: auth_login_form
          requested_slot: email

    - type: from_text
      conditions:
        - active_loop: password_recovery_form
          requested_slot: email

password:
  type: text
  influence_conversation: false
  mappings:
    - type: from_text
      conditions:
        - active_loop: auth_login_form
          requested_slot: password


  certificados:
    type: any
    influence_conversation: false
    mappings:
      - type: custom

  emocion_detectada:
    type: text
    influence_conversation: true
    mappings:
      - type: from_entity
        entity: emocion
      - type: from_text
        intent: detectar_emocion

encuesta_activa:
  type: bool
  influence_conversation: true
  initial_value: false
  mappings:
    - type: custom

  reanudar_pendiente:
    type: bool
    influence_conversation: true
    initial_value: false
    mappings:
      - type: custom

encuesta_tipo:
  type: categorical
  values:
    - positiva
    - negativa
    - neutra
  influence_conversation: true
  mappings:
    - type: custom

autosave_estado:
  type: text
  influence_conversation: false
  mappings:
    - type: custom

nivel_satisfaccion:
  type: text
  influence_conversation: true
  mappings:
    - type: from_text
      conditions:
        - active_loop: encuesta_satisfaccion_form
          requested_slot: nivel_satisfaccion


problema_resuelto:
  type: text
  influence_conversation: true
  mappings:
    - type: from_text
      conditions:
        - active_loop: encuesta_satisfaccion_form
          requested_slot: problema_resuelto


calificacion_numerica:
  type: text
  influence_conversation: true
  mappings:
    - type: from_text
      conditions:
        - active_loop: encuesta_satisfaccion_form
          requested_slot: calificacion_numerica

comentario:
  type: text
  influence_conversation: true
  mappings:
    - type: from_text
      conditions:
        - active_loop: encuesta_satisfaccion_form
          requested_slot: comentario

satisfaccion:
  type: text
  influence_conversation: true
  mappings:
    - type: custom

feedback_texto:
  type: text
  influence_conversation: false
  mappings:
    - type: from_text
      conditions:
        - active_loop: feedback_form
          requested_slot: feedback_texto


reanudar_pendiente:
  type: bool
  initial_value: false
  influence_conversation: true
  mappings:
    - type: custom

  usuario:
    type: text
    influence_conversation: false
    mappings:
      - type: from_text
        conditions:
          - active_loop: feedback_form
            requested_slot: usuario

  mensaje:
    type: text
    influence_conversation: false
    mappings:
      - type: from_text
        conditions:
          - active_loop: feedback_form
            requested_slot: mensaje

nombre:
  type: text
  influence_conversation: false
  mappings:
    - type: from_entity
      entity: nombre
    - type: custom

motivo_soporte:
  type: categorical
  values:
    - acceso
    - calificaciones
    - certificados
    - tecnico
    - otro
  influence_conversation: true
  mappings:
    - type: from_entity
      entity: motivo_soporte
    - type: custom

prefer_contacto:
  type: categorical
  values:
    - email
    - whatsapp
    - ninguno
  influence_conversation: false
  mappings:
    - type: from_entity
      entity: prefer_contacto
    - type: custom

phone:
  type: text
  influence_conversation: false
  mappings:
    - type: from_entity
      entity: phone
    - type: custom

derivacion_humano:
  type: bool
  influence_conversation: true
  mappings:
    - type: custom

tipo_soporte:
  type: categorical
  values:
    - interno
    - externo
    - tecnico
    - academico
    - administrativo
    - otro
  influence_conversation: true
  mappings:
    - type: custom

menu_actual:
  type: categorical
  values:
    - principal
    - academico
    - administrativo
    - soporte
  influence_conversation: true
  mappings:
    - type: custom

  evento_seguridad:
    type: categorical
    influence_conversation: false
    values:
      - desconexion
      - inactividad
    mappings:
      - type: custom

  auth_token:
    type: text
    influence_conversation: false
    mappings:
      - type: custom

  cedula:
    type: text
    influence_conversation: false
    mappings:
      - type: custom

  soporte_mensaje:
    type: text
    influence_conversation: false
    mappings:
      - type: custom

  escalar_humano:
    type: bool
    influence_conversation: true
    mappings:
      - type: custom

soporte_form_fallback_count:
  type: float
  influence_conversation: false
  mappings:
    - type: custom

confirmacion_cierre:
  type: text
  influence_conversation: true
  mappings:
    - type: custom

forms:

  auth_login_form:
    required_slots:
      - email
      - password

  encuesta_satisfaccion_form:
    required_slots:
      - nivel_satisfaccion
      - problema_resuelto
      - calificacion_numerica
      - comentario

  feedback_form:
    required_slots:
      - feedback_texto
      - usuario
      - mensaje

  soporte_form:
    required_slots:

      nombre:
        - type: from_entity
          entity: nombre
        - type: from_text

      email:
        - type: from_entity
          entity: email
        - type: from_text

      mensaje:
        - type: from_entity
          entity: mensaje
        - type: from_text


